{
  "manifest_version": 3,
  "name": "SVG Downloader for Flaticon - Free Vector Icons",
  "short_name": "Flaticon SVG",
  "version": "0.2.0",
  "description": "Download and copy free SVG vector icons and stickers from Flaticon without daily limits. Quick one-click SVG exporter.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "SVG Downloader for Flaticon",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.flaticon.com/*",
        "https://*.flaticon.es/*"
      ],
      "js": ["src/content/index.js"],
      "run_at": "document_idle"
    }
  ]
}